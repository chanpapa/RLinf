+
+    async def _collect_trajectory_chunk(
+        self, channel: Channel, key: TrajectoryKey
+    ) -> None:
+        """Join the policy and environment fragments for this env's chunk."""
+        received = 0
+        while received < 2 * self.train_num_envs_per_stage:
+            part = await channel.get(
+                key=("trajectory", key), async_op=True
+            ).async_wait()
+            received += sum(source.size for source in part.sources)
+            self._completed_trajectories.extend(
+                self._trajectory_collector.collect(part, "trajectory")
+            )
+
+    @Worker.timer("env/send_rollout_trajectories")
+    async def _send_rollout_trajectories(self, channel: Channel) -> None:
+        """Upload the complete rollout after all env stages and epochs finish."""
+        works = [
+            channel.put(trajectory, key=key, async_op=True)
+            for key, trajectory in self._completed_trajectories
+        ]
+        for work in works:
+            await work.async_wait()
+        self._completed_trajectories.clear()
 
     @Worker.timer("evaluate")
     def evaluate(self, input_channel: Channel, rollout_channel: Channel):
